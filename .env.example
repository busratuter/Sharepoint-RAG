# Azure Kimlik Bilgileri
TENANT_ID=your_tenant_id_here
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here

# SharePoint Site ID
SITE_ID=your_site_id_here

# Azure OpenAI Bilgileri
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=your_azure_openai_endpoint_here
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=your_azure_openai_embedding_deployment_here
AZURE_OPENAI_API_VERSION=your_azure_openai_api_version_here

# Azure Blob Storage Bilgileri
BLOB_CONNECTION_STRING=your_blob_connection_string_here
BLOB_CONTAINER_NAME=your_container_name_here
